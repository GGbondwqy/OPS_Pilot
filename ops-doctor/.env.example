# ============================================================
# OpsDoctor 配置模板
# 用法：复制本文件为 .env 后修改；或直接运行 `python -m app.cli setup` 向导
# 所有变量都有安全默认值，AI 模型三项留空时系统自动使用内置规则诊断模式
# ============================================================

# ---------- 服务 ----------
# API 监听地址：仅本机用 127.0.0.1；供 Zabbix/局域网访问用 0.0.0.0
OPSDOCTOR_HOST=127.0.0.1
OPSDOCTOR_PORT=8000
# 数据目录（数据库、通知、模拟状态、令牌都存放于此，请勿提交到 Git）
# OPSDOCTOR_DATA_DIR=./data

# ---------- 告警接入令牌 ----------
# Zabbix Webhook 调用 POST /webhook/zabbix 时需携带 X-OpsDoctor-Token
# 留空 = 首次启动自动生成随机令牌并保存到 data/webhook_token
# OPSDOCTOR_WEBHOOK_TOKEN=

# ---------- 内部管理令牌 ----------
# 审批决策、手动触发调查等内部接口需携带 X-OpsDoctor-Admin-Token
# 留空 = 首次启动自动生成随机令牌并保存到 data/admin_token
# OPSDOCTOR_ADMIN_TOKEN=

# ---------- AI 模型（可全部留空，后续随时补充） ----------
# 支持任意 OpenAI 兼容接口：OpenAI / DeepSeek / 通义 / Moonshot / Ollama / 公司内部网关等
# 三项都填写后，事故调查将使用大模型；留空则使用内置规则诊断（功能完整，标注为规则模式）
# 示例：https://api.openai.com/v1   https://api.deepseek.com/v1   http://127.0.0.1:11434/v1
# OPSDOCTOR_LLM_BASE_URL=
# OPSDOCTOR_LLM_API_KEY=
# OPSDOCTOR_LLM_MODEL=
# OPSDOCTOR_LLM_TIMEOUT_S=120

# ---------- 监控数据源 ----------
# mock  = 内置模拟数据源（默认，开箱即用）
# zabbix = 通过 Zabbix JSON-RPC API 只读查询真实数据
OPSDOCTOR_MONITORING_SOURCE=mock
# OPSDOCTOR_ZABBIX_URL=http://zabbix.example.com
# OPSDOCTOR_ZABBIX_TOKEN=
# 队列积压告警阈值（复验时判定恢复用，应与 Zabbix 触发器一致）
OPSDOCTOR_QUEUE_BACKLOG_THRESHOLD=100

# ---------- 运行环境 ----------
# lab = 实验环境（允许执行白名单内的修复动作）；其他任何值 = 禁止一切写动作
OPSDOCTOR_RUN_ENVIRONMENT=lab

# ---------- 通知 ----------
# file     = 写入 data/notifications.jsonl（默认）
# webhook  = 通用 JSON Webhook（POST {"subject","summary","state"}）
# dingtalk = 钉钉群机器人
OPSDOCTOR_NOTIFICATION_MODE=file
# OPSDOCTOR_NOTIFICATION_WEBHOOK_URL=
# OPSDOCTOR_DINGTALK_WEBHOOK_URL=

# ---------- 后台工作器 ----------
OPSDOCTOR_WORKER_ENABLED=true
OPSDOCTOR_WORKER_INTERVAL_S=2

# ---------- 时区显示 ----------
# 数据库统一存 UTC，周报/通知按此时区展示
OPSDOCTOR_DISPLAY_TZ=Asia/Shanghai
