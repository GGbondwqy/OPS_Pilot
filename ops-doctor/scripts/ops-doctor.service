# OpsDoctor systemd 服务模板
# 安装（把 /opt/ops-doctor 替换为你的实际部署路径）：
#   sudo cp scripts/ops-doctor.service /etc/systemd/system/ops-doctor.service
#   sudo sed -i 's#/opt/ops-doctor#<你的部署路径>#g' /etc/systemd/system/ops-doctor.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now ops-doctor
# 查看日志：journalctl -u ops-doctor -f

[Unit]
Description=OpsDoctor AIOps Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 用专用用户运行（推荐）：sudo useradd -r -s /usr/sbin/nologin ops-doctor && sudo chown -R ops-doctor:ops-doctor /opt/ops-doctor
# 若用你自己的用户运行，把下面两行改为你的用户名
User=ops-doctor
Group=ops-doctor
WorkingDirectory=/opt/ops-doctor
# .env 需包含 OPSDOCTOR_HOST 与 OPSDOCTOR_PORT 两行（install.sh 复制的模板自带）
EnvironmentFile=/opt/ops-doctor/.env
ExecStart=/opt/ops-doctor/.venv/bin/python -m uvicorn app.main:app --host ${OPSDOCTOR_HOST} --port ${OPSDOCTOR_PORT}
Restart=on-failure
RestartSec=3

# 基础安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/ops-doctor

[Install]
WantedBy=multi-user.target
